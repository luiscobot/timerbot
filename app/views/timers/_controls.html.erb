<%# Plain forms: Turbo submits them and the 204 means nothing to navigate to;
    the change comes back over the broadcast. .button_to is display: contents,
    so the buttons are the flex items. %>
<div id="timer_controls" class="controls">
  <% if timer.running? %>
    <%= button_to t("controls.pause"), timer_run_path(timer), method: :delete,
                  class: "control pause", title: "#{t("controls.pause")} (#{t("space")})" %>
  <% else %>
    <% label = t(timer.paused? ? "controls.resume" : "controls.start") %>
    <%= button_to label, timer_run_path(timer), class: "control start",
                  title: "#{label} (#{t("space")})" %>
  <% end %>

  <%= button_to t("controls.reset"), timer_reset_path(timer), class: "control reset",
                title: "#{t("controls.reset")} (R)" %>
</div>
